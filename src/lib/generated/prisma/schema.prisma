generator client {
  provider        = "prisma-client-js"
  output          = "../src/lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

model ChainState {
  id              String @id @default(cuid())
  userAddress     String @db.Citext
  contract        String @db.Citext
  lastBlockNumber Int    @default(0)

  @@unique([userAddress, contract], name: "contract_userAddress")
}

model User {
  id                 String                 @id @default(cuid())
  walletAddress      String                 @unique @db.Citext
  username           String
  bio                String?
  profileBanner      String?
  profileAvatar      String
  x                  String?
  instagram          String?
  website            String?
  telegram           String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  collections        Collection[]
  submissions        CollectionSubmission[]
  holderRewardsMulti HolderRewardMulti[]
  ownedNFTs          NFT[]                  @relation("ownedNFTs")
  rewardClaimLogs    RewardClaimLog[]
  stolenReports      StolenItem[]           @relation("StolenReporter")

  // Warpool
  warpoolEntries         WarpoolEntry[]
  warpoolReservations    WarpoolReservation[]
  warpoolActivities      WarpoolActivity[]
  warpoolCapturesAsOwner WarpoolCapture[]     @relation("WarpoolCaptureOriginalOwner")

  // Admin proposals
  adminProposalsCreated AdminProposal[]      @relation("AdminProposalCreatedByUser")
  adminProposalsEdited  AdminProposal[]      @relation("AdminProposalLastEditedByUser")
  adminProposalEvents   AdminProposalEvent[] @relation("AdminProposalEventActorUser")
}

model Collection {
  id           String            @id @default(cuid())
  name         String
  symbol       String
  contract     String            @unique @db.Citext
  description  String?
  logoUrl      String?
  coverUrl     String?
  standard     String            @default("ERC721")
  supply       Int?
  baseUri      String?
  gatewayPref  GatewayPref       @default(PUBLIC)
  indexStatus  IndexStatus       @default(PENDING)
  x            String?
  instagram    String?
  website      String?
  discord      String?
  telegram     String?
  floorPrice   Float             @default(0)
  volume       Float             @default(0)
  itemsCount   Int               @default(0)
  ownersCount  Int               @default(0)
  change24h    Float             @default(0)
  creatorId    String
  ownerAddress String            @db.Citext
  isOrphan     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assetUploads AssetUpload[]
  creator      User              @relation(fields: [creatorId], references: [id])
  deployment   DeployedContract?
  nfts         NFT[]
  presale      Presale?
  publicSale   PublicSale?

  @@index([creatorId])
  @@index([ownerAddress])
  @@index([indexStatus])
}

model NFT {
  id               String               @id @default(cuid())
  tokenId          String
  name             String?
  imageUrl         String?
  description      String?
  traits           Json?
  attributes       Json?
  tokenUri         String?
  contract         String               @db.Citext
  standard         String?
  rawMetadata      Json?
  royaltyBps       Int?
  royaltyRecipient String?              @db.Citext
  ownerId          String?
  collectionId     String?
  single721Id      String?
  single1155Id     String?
  status           NftStatus            @default(PENDING)
  retryCount       Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  rarityScore      Decimal?             @db.Decimal(38, 18)
  auctionEntries   Auction[]
  listingEntries   MarketplaceListing[]
  sales            MarketplaceSale[]
  collection       Collection?          @relation(fields: [collectionId], references: [id])
  owner            User?                @relation("ownedNFTs", fields: [ownerId], references: [id])
  single1155       Single1155?          @relation(fields: [single1155Id], references: [id])
  single721        Single721?           @relation(fields: [single721Id], references: [id])
  activities       NFTActivity[]

  // Warpool
  warpoolEntries      WarpoolEntry[]
  warpoolReservations WarpoolReservation[]
  warpoolActivities   WarpoolActivity[]
  warpoolCaptures     WarpoolCapture[]

  @@unique([contract, tokenId])
  @@unique([tokenId, contract, collectionId])
  @@index([contract])
  @@index([ownerId])
}

model TraitStat {
  id         String   @id @default(cuid())
  contract   String   @db.Citext
  trait_type String
  value      Json
  count      Int
  frequency  Float
  createdAt  DateTime @default(now())

  @@unique([contract, trait_type, value])
  @@index([contract])
}

model NFTActivity {
  id          String   @id @default(cuid())
  nftId       String
  contract    String   @db.Citext
  tokenId     String
  type        String
  fromAddress String   @db.Citext
  toAddress   String   @db.Citext
  priceEtnWei Decimal? @db.Decimal(65, 0)
  txHash      String
  logIndex    Int      @default(0)
  blockNumber Int
  timestamp   DateTime
  marketplace String?
  rawData     Json?
  createdAt   DateTime @default(now())
  nft         NFT      @relation(fields: [nftId], references: [id])

  @@unique([txHash, logIndex])
  @@index([contract])
  @@index([tokenId])
  @@index([timestamp])
  @@index([contract, tokenId, blockNumber])
}

model Single721 {
  id               String            @id @default(cuid())
  name             String
  symbol           String
  contract         String            @unique @db.Citext
  tokenUri         String
  royaltyRecipient String            @db.Citext
  royaltyBps       Int
  creatorId        String
  ownerAddress     String            @db.Citext
  description      String?
  imageUrl         String?
  indexStatus      IndexStatus       @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assetUploads     AssetUpload[]
  deployment       DeployedContract?
  nfts             NFT[]

  @@index([indexStatus])
}

model Single1155 {
  id               String            @id @default(cuid())
  name             String
  symbol           String
  contract         String            @unique @db.Citext
  baseUri          String
  maxSupply        Int
  mintPriceEtnWei  Decimal           @db.Decimal(65, 0)
  maxPerWallet     Int
  royaltyRecipient String            @db.Citext
  royaltyBps       Int
  creatorId        String
  ownerAddress     String            @db.Citext
  description      String?
  imageUrl         String?
  indexStatus      IndexStatus       @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assetUploads     AssetUpload[]
  deployment       DeployedContract?
  balances         Erc1155Balance[]
  nfts             NFT[]

  @@index([indexStatus])
}

model Erc1155Balance {
  id           String     @id @default(cuid())
  single1155Id String
  ownerAddress String     @db.Citext
  balance      Int        @default(0)
  updatedAt    DateTime   @default(now())
  single1155   Single1155 @relation(fields: [single1155Id], references: [id])

  @@unique([single1155Id, ownerAddress])
  @@index([ownerAddress])
  @@index([single1155Id])
}

model Erc1155Holding {
  id           String   @id @default(cuid())
  contract     String   @db.Citext
  tokenId      String
  ownerAddress String   @db.Citext
  balance      Int      @default(0)
  updatedAt    DateTime @default(now())

  @@unique([contract, tokenId, ownerAddress])
  @@index([ownerAddress])
  @@index([contract, tokenId])
  @@index([contract, ownerAddress])
}

model MarketplaceListing {
  id               String        @id @default(cuid())
  nftId            String
  sellerAddress    String        @db.Citext
  quantity         Int           @default(1)
  priceEtnWei      Decimal       @db.Decimal(65, 0)
  currencyId       String?
  priceTokenAmount Decimal?      @db.Decimal(65, 0)
  status           ListingStatus @default(ACTIVE)
  startTime        DateTime      @default(now())
  endTime          DateTime?
  txHashCreated    String?
  txHashFilled     String?
  txHashCancelled  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  currency         Currency?     @relation(fields: [currencyId], references: [id])
  nft              NFT           @relation(fields: [nftId], references: [id])

  // Warpool
  relistCaptures WarpoolCapture[]

  @@index([sellerAddress])
  @@index([status])
  @@index([startTime])
  @@index([nftId])
  @@index([currencyId])
  @@index([nftId, status], map: "idx_listing_nft_status")
  @@index([sellerAddress, status], map: "idx_listing_seller_status")
}

model Auction {
  id                      String        @id @default(cuid())
  nftId                   String
  sellerAddress           String        @db.Citext
  quantity                Int           @default(1)
  startPriceEtnWei        Decimal       @db.Decimal(65, 0)
  highestBidEtnWei        Decimal?      @db.Decimal(65, 0)
  minIncrementEtnWei      Decimal?      @db.Decimal(65, 0)
  currencyId              String?
  startPriceTokenAmount   Decimal?      @db.Decimal(65, 0)
  highestBidTokenAmount   Decimal?      @db.Decimal(65, 0)
  minIncrementTokenAmount Decimal?      @db.Decimal(65, 0)
  startTime               DateTime      @default(now())
  endTime                 DateTime
  status                  AuctionStatus @default(ACTIVE)
  txHashCreated           String?
  txHashFinalized         String?
  txHashCancelled         String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  highestBidder           String?       @db.Citext
  currency                Currency?     @relation(fields: [currencyId], references: [id])
  nft                     NFT           @relation(fields: [nftId], references: [id])
  bids                    AuctionBid[]

  @@index([sellerAddress])
  @@index([status])
  @@index([endTime])
  @@index([nftId])
  @@index([currencyId])
  @@index([nftId, status], map: "idx_auction_nft_status")
  @@index([sellerAddress, status], map: "idx_auction_seller_status")
}

model AuctionBid {
  id            String    @id @default(cuid())
  auctionId     String
  bidderAddress String    @db.Citext
  amountWei     Decimal   @db.Decimal(65, 0)
  currencyId    String?
  txHash        String
  logIndex      Int       @default(0)
  blockNumber   Int
  timestamp     DateTime
  createdAt     DateTime  @default(now())
  auction       Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  currency      Currency? @relation(fields: [currencyId], references: [id])

  @@unique([txHash, logIndex])
  @@index([auctionId, timestamp])
  @@index([bidderAddress])
  @@index([blockNumber])
}

model DeployedContract {
  id                 String         @id @default(cuid())
  contractType       ContractType
  cloneAddress       String         @unique @db.Citext
  implementationAddr String         @db.Citext
  factoryAddress     String         @db.Citext
  deployerAddress    String         @db.Citext
  txHash             String         @unique
  blockNumber        Int
  metadataOption     MetadataOption
  feeRecipient       String         @db.Citext
  feeAmountEtnWei    Decimal        @db.Decimal(65, 0)
  royaltyRecipient   String
  royaltyBps         Int
  baseURI            String?
  maxSupply          Int?
  rawInit            Json?
  createdAt          DateTime       @default(now())
  collectionId       String?        @unique
  single721Id        String?        @unique
  single1155Id       String?        @unique
  collection         Collection?    @relation(fields: [collectionId], references: [id])
  single1155         Single1155?    @relation(fields: [single1155Id], references: [id])
  single721          Single721?     @relation(fields: [single721Id], references: [id])

  @@index([factoryAddress])
  @@index([deployerAddress])
}

model FeeConfig {
  id              String         @id @default(cuid())
  contractType    ContractType
  metadataOption  MetadataOption
  feeRecipient    String         @db.Citext
  feeAmountEtnWei Decimal        @db.Decimal(65, 0)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  updatedByUserId String?
  targetUsdCents  Int?
  pricingSource   String         @default("CRYPTOCOMPARE")
  pricingPair     String         @default("ETNUSD")
  lastPriceUsd    Decimal?       @db.Decimal(20, 10)
  lastPriceAt     DateTime?
  logs            FeeConfigLog[]

  @@unique([contractType, metadataOption])
  @@index([active])
}

model FeeConfigLog {
  id                   String    @id @default(cuid())
  feeConfigId          String
  previousRecipient    String?   @db.Citext
  newRecipient         String?   @db.Citext
  previousAmountEtnWei Decimal?  @db.Decimal(65, 0)
  newAmountEtnWei      Decimal?  @db.Decimal(65, 0)
  changedByUserId      String?
  reason               String?
  createdAt            DateTime  @default(now())
  feeConfig            FeeConfig @relation(fields: [feeConfigId], references: [id])

  @@index([feeConfigId])
  @@index([createdAt])
}

model PublicSale {
  id           String     @id @default(cuid())
  collectionId String     @unique
  startTime    DateTime
  priceEtnWei  Decimal    @db.Decimal(65, 0)
  maxPerWallet Int
  maxPerTx     Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id])
}

model Presale {
  id              String                    @id @default(cuid())
  collectionId    String                    @unique
  startTime       DateTime
  endTime         DateTime
  priceEtnWei     Decimal                   @db.Decimal(65, 0)
  maxSupply       Int
  merkleRoot      String
  whitelistCount  Int?
  allowlistCommit String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  collection      Collection                @relation(fields: [collectionId], references: [id])
  whitelist       PresaleWhitelistAddress[]
}

model PresaleWhitelistAddress {
  id            String  @id @default(cuid())
  presaleId     String
  address       String  @db.Citext
  maxAllocation Int?
  presale       Presale @relation(fields: [presaleId], references: [id])

  @@unique([presaleId, address])
  @@index([address])
  @@index([presaleId])
}

model PresaleDraft {
  id                  String      @id @default(cuid())
  creatorUserId       String
  addresses           Json
  count               Int
  merkleRoot          String
  sha256Commit        String      @unique
  status              DraftStatus @default(DRAFT)
  consumedAt          DateTime?
  consumedByPresaleId String?
  createdAt           DateTime    @default(now())
  expiresAt           DateTime?

  @@index([creatorUserId])
  @@index([status, createdAt])
}

model AssetUpload {
  id             String      @id @default(cuid())
  uploaderUserId String?
  collectionId   String?
  single721Id    String?
  single1155Id   String?
  provider       String      @default("PINATA")
  cid            String
  url            String?
  bytes          Int?
  sha256         String?
  contentType    String?
  originalName   String?
  createdAt      DateTime    @default(now())
  collection     Collection? @relation(fields: [collectionId], references: [id])
  single1155     Single1155? @relation(fields: [single1155Id], references: [id])
  single721      Single721?  @relation(fields: [single721Id], references: [id])

  @@index([cid])
  @@index([collectionId])
  @@index([single721Id])
  @@index([single1155Id])
}

model CollectionSubmission {
  id                String           @id @default(cuid())
  submittedByUserId String
  contract          String           @unique @db.Citext
  ownerAddress      String?          @db.Citext
  name              String?
  symbol            String?
  logoUrl           String?
  coverUrl          String?
  baseUri           String?
  supply            Int?
  description       String?
  website           String?
  x                 String?
  instagram         String?
  telegram          String?
  feeTxHash         String?          @unique
  feePaidWei        Decimal?         @db.Decimal(65, 0)
  feeVerifiedAt     DateTime?
  ownershipVerified Boolean          @default(false)
  status            SubmissionStatus @default(PENDING)
  statusReason      String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  submittedBy       User             @relation(fields: [submittedByUserId], references: [id])

  @@index([status, createdAt])
}

model NFTRarity {
  contract  String   @db.Citext
  tokenId   String
  score     Decimal  @db.Decimal(38, 18)
  rank      Int
  updatedAt DateTime @default(now())

  @@id([contract, tokenId])
  @@index([contract, rank])
}

model HolderReward {
  user_id            String   @id
  wallet_address     String?  @unique @db.Citext
  last_acc_per_token Decimal  @default(0) @db.Decimal(78, 27)
  claimed_etn        Decimal  @default(0) @db.Decimal(78, 18)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)
}

model RewardAccumulator {
  id            String   @id
  acc_per_token Decimal  @default(0) @db.Decimal(78, 27)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
}

model Currency {
  id                 String                  @id @default(cuid())
  symbol             String
  decimals           Int                     @default(18)
  kind               CurrencyKind            @default(NATIVE)
  tokenAddress       String?                 @unique @db.Citext
  active             Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  auctions           Auction[]
  bids               AuctionBid[]
  holderRewards      HolderRewardMulti[]
  listings           MarketplaceListing[]
  sales              MarketplaceSale[]
  rewardAccumulators RewardAccumulatorMulti?
  claimLogs          RewardClaimLog[]
  distributionLogs   RewardDistributionLog[]

  @@unique([symbol, tokenAddress])
}

model MarketplaceSale {
  id                      String    @id @default(cuid())
  nftId                   String
  buyerAddress            String    @db.Citext
  sellerAddress           String    @db.Citext
  quantity                Int       @default(1)
  priceEtnWei             Decimal   @db.Decimal(65, 0)
  royaltyPaidWei          Decimal?  @db.Decimal(65, 0)
  marketplaceFeePaidWei   Decimal?  @db.Decimal(65, 0)
  currencyId              String?
  priceTokenAmount        Decimal?  @db.Decimal(65, 0)
  royaltyPaidTokenAmount  Decimal?  @db.Decimal(65, 0)
  feePaidTokenAmount      Decimal?  @db.Decimal(65, 0)
  royaltyRecipient        String?   @db.Citext
  marketplaceFeeRecipient String?   @db.Citext
  txHash                  String
  logIndex                Int       @default(0)
  blockNumber             Int
  timestamp               DateTime
  createdAt               DateTime  @default(now())
  currency                Currency? @relation(fields: [currencyId], references: [id])
  nft                     NFT       @relation(fields: [nftId], references: [id])

  @@unique([txHash, logIndex])
  @@index([buyerAddress])
  @@index([sellerAddress])
  @@index([nftId])
  @@index([timestamp])
  @@index([currencyId, timestamp])
}

model RewardAccumulatorMulti {
  id          String   @id @default(cuid())
  currencyId  String   @unique
  accPerToken Decimal  @default(0) @db.Decimal(78, 27)
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  currency    Currency @relation(fields: [currencyId], references: [id])
}

model HolderRewardMulti {
  id              String   @id @default(cuid())
  userId          String?
  walletAddress   String   @db.Citext
  currencyId      String
  lastAccPerToken Decimal  @default(0) @db.Decimal(78, 27)
  claimedAmount   Decimal  @default(0) @db.Decimal(78, 18)
  updatedAt       DateTime @default(now()) @db.Timestamptz(6)
  currency        Currency @relation(fields: [currencyId], references: [id])
  user            User?    @relation(fields: [userId], references: [id])

  @@unique([walletAddress, currencyId])
  @@index([userId])
}

model RewardDistributionLog {
  id          String   @id @default(cuid())
  currencyId  String
  amount      Decimal  @db.Decimal(78, 18)
  txHash      String?
  blockNumber Int?
  timestamp   DateTime @default(now())
  note        String?
  currency    Currency @relation(fields: [currencyId], references: [id])

  @@index([currencyId, timestamp])
}

model RewardClaimLog {
  id            String   @id @default(cuid())
  walletAddress String   @db.Citext
  userId        String?
  currencyId    String
  amount        Decimal  @db.Decimal(78, 18)
  txHash        String?
  timestamp     DateTime @default(now())
  currency      Currency @relation(fields: [currencyId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])

  @@index([walletAddress, currencyId, timestamp])
}

model StolenItem {
  id              String       @id @default(cuid())
  contract        String       @db.Citext
  tokenId         String
  status          StolenStatus @default(FLAGGED)
  source          StolenSource @default(USER)
  reporterAddress String?      @db.Citext
  reporterUserId  String?
  evidenceUrl     String?
  notes           String?
  disputed        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  reporter        User?        @relation("StolenReporter", fields: [reporterUserId], references: [id])

  @@unique([contract, tokenId])
  @@index([status])
  @@index([contract, tokenId, status])
}

model StolenEvent {
  id           String   @id @default(cuid())
  contract     String   @db.Citext
  tokenId      String
  action       String
  actorAddress String?  @db.Citext
  txHash       String?
  logIndex     Int?     @default(0)
  blockNumber  Int?
  timestamp    DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())

  @@index([contract, tokenId, timestamp])
  @@index([txHash, logIndex])
}

model MultisigSafe {
  id             String          @id @default(cuid())
  contract       String          @unique @db.Citext
  name           String?
  threshold      Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  owners         MultisigOwner[]
  txs            MultisigTx[]
  adminProposals AdminProposal[]

  @@index([threshold])
}

model MultisigOwner {
  id           String       @id @default(cuid())
  safeId       String
  ownerAddress String       @db.Citext
  addedAt      DateTime     @default(now())
  removedAt    DateTime?
  safe         MultisigSafe @relation(fields: [safeId], references: [id])

  @@unique([safeId, ownerAddress])
  @@index([ownerAddress])
}

model MultisigTx {
  id                   String             @id @default(cuid())
  safeId               String
  nonce                Int
  to                   String             @db.Citext
  valueWei             Decimal            @default(0) @db.Decimal(65, 0)
  dataHex              String?
  operation            Int?
  submittedBy          String?            @db.Citext
  status               MultisigTxStatus   @default(SUBMITTED)
  executedTxHash       String?
  createdAt            DateTime           @default(now())
  executedAt           DateTime?
  approvals            MultisigApproval[]
  safe                 MultisigSafe       @relation(fields: [safeId], references: [id])
  linkedAdminProposals AdminProposal[]    @relation("AdminProposalSubmittedMultisigTx")

  @@unique([safeId, nonce])
  @@index([status])
  @@index([to])
}

model MultisigApproval {
  id           String     @id @default(cuid())
  txId         String
  ownerAddress String     @db.Citext
  signature    String?
  createdAt    DateTime   @default(now())
  tx           MultisigTx @relation(fields: [txId], references: [id])

  @@unique([txId, ownerAddress])
  @@index([ownerAddress])
}

model PendingChainAction {
  id        String                 @id @default(cuid())
  type      PendingChainActionType
  txHash    String                 @unique
  from      String                 @db.Citext
  chainId   Int
  payload   Json
  relatedId String?
  status    PendingStatus          @default(PENDING)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
}

//
// Warpool domain models
//

model WarpoolContract {
  id        String              @id @default(cuid())
  kind      WarpoolContractKind
  address   String              @unique @db.Citext
  chainId   Int
  label     String?
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([chainId, kind], map: "uq_warpool_contract_chain_kind")
  @@index([active, kind])
}

model WarpoolQueueConfig {
  id                   String           @id @default(cuid())
  chainId              Int
  queueKey             String           @db.Citext
  slug                 WarpoolQueueSlug
  tier                 Int
  mode                 Int
  enabled              Boolean
  singleEntryPerWallet Boolean          @default(true)
  targetSize           Int
  minStartSize         Int
  openDurationSeconds  Int
  stakeAmountRaw       Decimal          @db.Decimal(78, 0)
  platformFeeBps       Int
  firstPlaceBps        Int
  secondPlaceBps       Int
  thirdPlaceBps        Int
  configVersion        BigInt
  sourceContract       String           @db.Citext
  syncedAt             DateTime         @default(now())
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([chainId, queueKey, configVersion], map: "uq_warpool_queue_version")
  @@unique([chainId, slug, configVersion], map: "uq_warpool_slug_version")
  @@index([chainId, slug, syncedAt])
}

model WarpoolGlobalConfigSnapshot {
  id                     String   @id @default(cuid())
  chainId                Int
  configContract         String   @db.Citext
  configVersion          BigInt
  comradesCollection     String?  @db.Citext
  relicsCollection       String?  @db.Citext
  dcntToken              String?  @db.Citext
  treasury               String?  @db.Citext
  workerOperator         String?  @db.Citext
  entriesPaused          Boolean  @default(false)
  reservationsPaused     Boolean  @default(false)
  settlementsPaused      Boolean  @default(false)
  relicsEnabled          Boolean  @default(true)
  fatigueEnabled         Boolean  @default(true)
  token11FeeShareEnabled Boolean  @default(true)
  token11FeeShareBps     Int      @default(0)
  relicMinDiscountBps    Int?
  relicMaxDiscountBps    Int?
  discountSeatCap        Int?
  token11SeatCap         Int?
  reservationTtlSeconds  Int?
  fatigueMaxConsecutive  Int?
  fatigueCooldownSeconds Int?
  roundsPerMatch         Int?
  traitPowerMin          Int?
  traitPowerMax          Int?
  roundVarianceMax       Int?
  microMomentumMax       Int?
  syncedAt               DateTime @default(now())
  createdAt              DateTime @default(now())

  @@unique([chainId, configContract, configVersion], map: "uq_warpool_global_config_version")
  @@index([chainId, syncedAt])
}

model WarpoolPool {
  id                    String               @id @default(cuid())
  chainId               Int
  coreContract          String               @db.Citext
  poolIdOnChain         BigInt
  queueKey              String               @db.Citext
  queueSlug             WarpoolQueueSlug?
  configVersion         BigInt
  state                 WarpoolPoolStatus
  tier                  Int
  mode                  Int
  singleEntryPerWallet  Boolean
  targetSize            Int
  minStartSize          Int
  entrantCount          Int                  @default(0)
  runnableSize          Int                  @default(0)
  stakeAmountRaw        Decimal              @db.Decimal(78, 0)
  platformFeeBps        Int
  firstPlaceBps         Int
  secondPlaceBps        Int
  thirdPlaceBps         Int
  relicMinDiscountBps   Int?
  relicMaxDiscountBps   Int?
  discountSeatCap       Int                  @default(0)
  token11SeatCap        Int                  @default(0)
  token11FeeShareBps    Int                  @default(0)
  discountSeatsUsed     Int                  @default(0)
  discountSeatsReserved Int                  @default(0)
  token11SeatsUsed      Int                  @default(0)
  comradesCollection    String               @db.Citext
  relicsCollection      String?              @db.Citext
  dcntToken             String               @db.Citext
  treasury              String               @db.Citext
  openedAt              DateTime
  expiresAt             DateTime
  lockedAt              DateTime?
  battleReadyAt         DateTime?
  settledAt             DateTime?
  closedAt              DateTime?
  expiredRefundedAt     DateTime?
  seedBlockNumber       Int?
  openTxHash            String?
  lockTxHash            String?
  settleTxHash          String?
  entries               WarpoolEntry[]
  reservations          WarpoolReservation[]
  activities            WarpoolActivity[]
  battle                WarpoolBattle?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([chainId, coreContract, poolIdOnChain], map: "uq_warpool_pool_chain")
  @@index([queueKey, state])
  @@index([queueSlug, state, expiresAt])
  @@index([state, expiresAt])
}

model WarpoolEntry {
  id                     String              @id @default(cuid())
  chainId                Int
  coreContract           String              @db.Citext
  entryIdOnChain         BigInt
  poolId                 String
  pool                   WarpoolPool         @relation(fields: [poolId], references: [id], onDelete: Cascade)
  userId                 String?
  user                   User?               @relation(fields: [userId], references: [id])
  userAddress            String              @db.Citext
  nftId                  String?
  nft                    NFT?                @relation(fields: [nftId], references: [id])
  comradeContract        String              @db.Citext
  comradeTokenId         String
  relicContract          String?             @db.Citext
  relicTokenId           String?
  relicType              WarpoolRelicType    @default(NONE)
  status                 WarpoolEntryStatus
  placement              Int?
  selectedForBattle      Boolean             @default(false)
  relicDiscountBps       Int?
  baseStakeAmountRaw     Decimal             @db.Decimal(78, 0)
  paidStakeAmountRaw     Decimal             @db.Decimal(78, 0)
  refundedStakeAmountRaw Decimal?            @db.Decimal(78, 0)
  prizeAmountRaw         Decimal?            @db.Decimal(78, 0)
  joinedAt               DateTime
  joinedTxHash           String?
  reservationId          String?             @unique
  reservation            WarpoolReservation? @relation(fields: [reservationId], references: [id])
  capture                WarpoolCapture?
  activities             WarpoolActivity[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@unique([chainId, coreContract, entryIdOnChain], map: "uq_warpool_entry_chain")
  @@index([poolId, status])
  @@index([userAddress, joinedAt])
  @@index([comradeContract, comradeTokenId])
  @@index([nftId])
}

model WarpoolReservation {
  id                   String                   @id @default(cuid())
  chainId              Int
  coreContract         String                   @db.Citext
  reservationIdOnChain BigInt
  poolId               String
  pool                 WarpoolPool              @relation(fields: [poolId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?                    @relation(fields: [userId], references: [id])
  userAddress          String                   @db.Citext
  nftId                String?
  nft                  NFT?                     @relation(fields: [nftId], references: [id])
  comradeContract      String                   @db.Citext
  comradeTokenId       String
  relicContract        String                   @db.Citext
  relicTokenId         String
  status               WarpoolReservationStatus
  discountBps          Int?
  createdAtOnChain     DateTime
  expiresAtOnChain     DateTime
  consumedAt           DateTime?
  expiredAt            DateTime?
  createdTxHash        String?
  resolvedTxHash       String?
  entry                WarpoolEntry?
  activities           WarpoolActivity[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([chainId, coreContract, reservationIdOnChain], map: "uq_warpool_reservation_chain")
  @@index([poolId, status, expiresAtOnChain])
  @@index([userAddress, status])
}

model WarpoolBattle {
  id               String               @id @default(cuid())
  poolId           String               @unique
  pool             WarpoolPool          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  status           WarpoolBattleStatus  @default(PENDING)
  bracketSeed      String?              @db.Citext
  firstEntryId     String?
  secondEntryId    String?
  thirdEntryId     String?
  totalStakeRaw    Decimal?             @db.Decimal(78, 0)
  prizePoolRaw     Decimal?             @db.Decimal(78, 0)
  platformFeeRaw   Decimal?             @db.Decimal(78, 0)
  computedAt       DateTime?
  submittedAt      DateTime?
  settledAt        DateTime?
  settlementTxHash String?
  rawOutcome       Json?
  matches          WarpoolBattleMatch[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, updatedAt])
}

model WarpoolBattleMatch {
  id            String        @id @default(cuid())
  battleId      String
  battle        WarpoolBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  roundNumber   Int
  matchNumber   Int
  slotAEntryId  String?
  slotBEntryId  String?
  winnerEntryId String?
  loserEntryId  String?
  status        String        @default("PENDING")
  rawResult     Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([battleId, roundNumber, matchNumber], map: "uq_warpool_match_round_number")
  @@index([battleId, roundNumber])
}

model WarpoolCapture {
  id                   String               @id @default(cuid())
  entryId              String               @unique
  entry                WarpoolEntry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  nftId                String?
  nft                  NFT?                 @relation(fields: [nftId], references: [id])
  contract             String               @db.Citext
  tokenId              String
  originalOwnerId      String?
  originalOwner        User?                @relation("WarpoolCaptureOriginalOwner", fields: [originalOwnerId], references: [id])
  originalOwnerAddress String               @db.Citext
  capturedAt           DateTime
  status               WarpoolCaptureStatus @default(HELD)
  relistStatus         WarpoolRelistStatus  @default(NONE)
  relistListingId      String?
  relistListing        MarketplaceListing?  @relation(fields: [relistListingId], references: [id])
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([contract, tokenId, capturedAt], map: "uq_warpool_capture_asset_time")
  @@index([status, relistStatus])
  @@index([contract, tokenId])
}

model WarpoolActivity {
  id            String              @id @default(cuid())
  chainId       Int
  coreContract  String              @db.Citext
  poolId        String?
  pool          WarpoolPool?        @relation(fields: [poolId], references: [id], onDelete: Cascade)
  entryId       String?
  entry         WarpoolEntry?       @relation(fields: [entryId], references: [id], onDelete: SetNull)
  reservationId String?
  reservation   WarpoolReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?               @relation(fields: [userId], references: [id])
  userAddress   String?             @db.Citext
  nftId         String?
  nft           NFT?                @relation(fields: [nftId], references: [id])
  type          WarpoolActivityType
  txHash        String?             @db.Citext
  logIndex      Int?
  blockNumber   Int?
  timestamp     DateTime
  payload       Json?
  createdAt     DateTime            @default(now())

  @@unique([txHash, logIndex], map: "uq_warpool_activity_log")
  @@index([poolId, timestamp])
  @@index([userAddress, timestamp])
  @@index([type, timestamp])
}

//
// Admin proposal models
//

model AdminProposal {
  id                     String              @id @default(cuid())
  area                   AdminProposalArea
  kind                   AdminProposalKind
  title                  String
  slug                   String?             @db.Citext
  summary                String?
  description            String?
  safeId                 String?
  safe                   MultisigSafe?       @relation(fields: [safeId], references: [id])
  safeContract           String?             @db.Citext
  chainId                Int?
  createdByUserId        String?
  createdByUser          User?               @relation("AdminProposalCreatedByUser", fields: [createdByUserId], references: [id])
  createdByAddress       String?             @db.Citext
  lastEditedByUserId     String?
  lastEditedByUser       User?               @relation("AdminProposalLastEditedByUser", fields: [lastEditedByUserId], references: [id])
  lastEditedByAddress    String?             @db.Citext
  basedOnConfigVersion   BigInt?
  runtimeReferenceId     String?
  status                 AdminProposalStatus @default(DRAFT)
  actionCount            Int                 @default(0)
  submittedMultisigTxId  String?
  submittedMultisigTx    MultisigTx?         @relation("AdminProposalSubmittedMultisigTx", fields: [submittedMultisigTxId], references: [id])
  submittedMultisigNonce Int?
  submittedAt            DateTime?
  approvedAt             DateTime?
  executedAt             DateTime?
  cancelledAt            DateTime?
  failedAt               DateTime?
  snapshotJson           Json?
  metadataJson           Json?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  actions AdminProposalAction[]
  events  AdminProposalEvent[]

  @@index([area, kind, status, createdAt])
  @@index([safeContract, status, createdAt])
  @@index([createdByAddress, createdAt])
  @@index([submittedMultisigNonce])
}

model AdminProposalAction {
  id           String                    @id @default(cuid())
  proposalId   String
  proposal     AdminProposal             @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  orderIndex   Int
  label        String?
  summary      String?
  target       String                    @db.Citext
  valueWei     Decimal                   @default(0) @db.Decimal(78, 0)
  tokenAddress String?                   @db.Citext
  dataHex      String
  functionName String?
  argsJson     Json?
  status       AdminProposalActionStatus @default(PENDING)
  submittedAt  DateTime?
  executedAt   DateTime?
  failedAt     DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([proposalId, orderIndex], map: "uq_admin_proposal_action_order")
  @@index([proposalId, status, orderIndex])
}

model AdminProposalEvent {
  id           String        @id @default(cuid())
  proposalId   String
  proposal     AdminProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  actorUserId  String?
  actorUser    User?         @relation("AdminProposalEventActorUser", fields: [actorUserId], references: [id])
  actorAddress String?       @db.Citext
  type         String
  note         String?
  payloadJson  Json?
  createdAt    DateTime      @default(now())

  @@index([proposalId, createdAt])
  @@index([actorAddress, createdAt])
}

